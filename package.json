{
  "name": "mobile-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Android test automation with WebdriverIO, Appium and TypeScript",
  "scripts": {
    "test": "wdio run wdio.conf.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "app:download": "bash scripts/get-app.sh",
    "setup:appium": "node scripts/setup-appium.mjs",
    "postinstall": "node scripts/setup-appium.mjs"
  },
  "license": "MIT",
  "author": "Michael Filbert",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@wdio/appium-service": "^10.0.2",
    "@wdio/cli": "^10.0.2",
    "@wdio/junit-reporter": "^10.0.1",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "webdriverio": "^10.0.2"
  },
  "type": "module"
}
